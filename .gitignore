# Generated data: every map is regenerated from the registry seeds, never stored
*.h5
*.hdf5
*.npy
*.npz
teaser_data/

# Outputs written when re-running the pipeline (the shipped results live in results/)
paper/figures/
logs/
resnet_teaser/logs/
resnet_teaser/eval_out*/
results/eta_results_backup_*/
results/eta_results_hpc/
